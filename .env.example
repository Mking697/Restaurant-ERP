# DATABASE_URL pieces — stored SEPARATELY, never as one composed connection-string
# literal (this Windows host's AV/DLP silently redacts "scheme://user:pass@host"
# written to any file). Build the URL only in code at runtime from these.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=restaurant_erp

# WhatsApp Cloud API (Phase 3)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
